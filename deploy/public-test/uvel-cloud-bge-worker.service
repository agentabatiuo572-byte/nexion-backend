[Unit]
Description=UVEL TEST Cloud Share BGE-M3 inference worker
After=nexgrid-backend.service
Wants=nexgrid-backend.service

[Service]
Type=simple
DynamicUser=yes
StateDirectory=uvel-cloud-bge-worker
StateDirectoryMode=0700
WorkingDirectory=/var/lib/uvel-cloud-bge-worker
Environment=UVEL_CLOUD_WORKER_ENABLED=false
Environment=UVEL_CLOUD_WORKER_SCOPE=TEST
Environment=UVEL_CLOUD_BACKEND_URL=http://127.0.0.1:8110
Environment=UVEL_CLOUD_OLLAMA_URL=http://127.0.0.1:11435
Environment=UVEL_CLOUD_MODEL=bge-m3:567m
Environment=UVEL_CLOUD_MODEL_DIGEST=sha256:7907646426070047a77226ac3e684fbbe8410524f7b4a74d02837e43f2146bab
Environment=UVEL_CLOUD_POLL_SECONDS=60
EnvironmentFile=-/etc/uvel-cloud-bge-worker/worker.env
LoadCredential=cloud-worker-token:/srv/nexgrid/secrets/cloud-bge-worker.credential
ExecStart=/usr/bin/python3 -I -B /opt/uvel-cloud-bge-worker/cloud-bge-worker.py --heartbeat-only
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=10
TimeoutStopSec=330
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
