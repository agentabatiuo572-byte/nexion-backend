[Unit]
Description=UVEL TEST purchased hardware cloud BGE-M3 executor fleet
After=nexgrid-backend.service
Wants=nexgrid-backend.service

[Service]
Type=simple
DynamicUser=yes
StateDirectory=uvel-cloud-bge-fleet
StateDirectoryMode=0700
WorkingDirectory=/var/lib/uvel-cloud-bge-fleet
Environment=UVEL_CLOUD_WORKER_ENABLED=false
Environment=UVEL_CLOUD_FLEET_ENABLED=false
Environment=UVEL_CLOUD_WORKER_SCOPE=TEST
Environment=UVEL_CLOUD_BACKEND_URL=http://127.0.0.1:8110
Environment=UVEL_CLOUD_OLLAMA_URL=http://127.0.0.1:11435
Environment=UVEL_CLOUD_MODEL=bge-m3:567m
Environment=UVEL_CLOUD_MODEL_DIGEST=sha256:7907646426070047a77226ac3e684fbbe8410524f7b4a74d02837e43f2146bab
Environment=UVEL_CLOUD_POLL_SECONDS=60
# Each inference leases a distinct Ollama runner; 11435 remains with single worker/backend validation.
Environment=UVEL_CLOUD_FLEET_PARALLELISM=2
Environment=UVEL_CLOUD_FLEET_OLLAMA_URLS=http://127.0.0.1:11436,http://127.0.0.1:11437
Environment=UVEL_CLOUD_FLEET_EXCLUDE_DEVICE_IDS=1152,1202
EnvironmentFile=-/etc/uvel-cloud-bge-fleet/worker.env
LoadCredential=cloud-worker-token:/srv/nexgrid/secrets/cloud-bge-worker.credential
ExecStart=/usr/bin/python3 -I -B /opt/uvel-cloud-bge-worker/cloud-bge-worker.py --fleet
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=10
TimeoutStopSec=330
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
